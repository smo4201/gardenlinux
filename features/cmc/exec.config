#!/usr/bin/env bash

set -eufo pipefail

# Fetch the prebuilt, statically-linked CMC binaries (cmcd + cmcctl) and install them into the image
CMC_RELEASE="${CMC_RELEASE:-latest}"

if [ "${CMC_RELEASE}" = "latest" ]; then
	base="https://github.com/Fraunhofer-AISEC/cmc/releases/latest/download"
else
	base="https://github.com/Fraunhofer-AISEC/cmc/releases/download/${CMC_RELEASE}"
fi

for binary in cmcd cmcctl; do
	curl -fsSL --retry 3 -o "/usr/bin/${binary}" "${base}/${binary}"
	chmod 0755 "/usr/bin/${binary}"
done

systemctl enable cmcd.service
